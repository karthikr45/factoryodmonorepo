{
  "name": "factoryos",
  "version": "0.1.0",
  "private": true,
  "description": "FactoryOS - Manufacturing operations and finance platform for SMB manufacturers",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm build:packages && turbo run dev",
    "build:packages": "pnpm --filter @repo/types build && pnpm --filter @repo/validators build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @repo/database generate",
    "db:migrate": "pnpm --filter @repo/database migrate",
    "db:seed": "pnpm --filter @repo/database seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
