// FactoryOS Prisma schema
// Single source of truth for the entire database.
// Multi-tenancy: every row-scoped table carries orgId.
// Money: always stored as BigInt paise (₹1 = 100 paise). Never floats.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================================================================
// Enums
// ======================================================================

enum OrganisationType {
  FACTORY
  AGENCY
  CA_FIRM
  PLATFORM
}

enum OrganisationPlan {
  FREE
  PRO
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  ACCOUNTANT
  CA
  AGENCY_ADMIN
  AGENCY_SUPERVISOR
  WORKER
}

enum OrderStatus {
  ENQUIRY
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum JobCardStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum WorkerDeploymentStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum JournalSourceType {
  ORDER
  ATTENDANCE
  PURCHASE
  MANUAL
}

enum LedgerType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum GSTReturnType {
  GSTR1
  GSTR3B
  GSTR9
}

enum GSTReturnStatus {
  DRAFT
  FILED
  PENDING
}

enum NotificationChannel {
  INAPP
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationType {
  ORDER_STATUS_CHANGED
  JOBCARD_ASSIGNED
  JOBCARD_COMPLETED
  ATTENDANCE_MARKED
  ATTENDANCE_APPROVED
  ATTENDANCE_DISPUTED
  PAYROLL_READY
  CA_QUERY_RAISED
  GST_RETURN_DUE
  GENERIC
}

// ======================================================================
// Core tables
// ======================================================================

model Organisation {
  id        String           @id @default(uuid())
  name      String
  gstin     String?          @unique
  type      OrganisationType
  plan      OrganisationPlan @default(FREE)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users             User[]
  departments       Department[]
  orders            Order[]
  jobCards          JobCard[]
  customers         Customer[]
  workers           Worker[]           @relation("AgencyWorkers")
  deploymentsAsFactory WorkerDeployment[] @relation("FactoryDeployments")
  deploymentsAsAgency  WorkerDeployment[] @relation("AgencyDeployments")
  attendanceAsFactory  AttendanceRecord[] @relation("FactoryAttendance")
  attendanceAsAgency   AttendanceRecord[] @relation("AgencyAttendance")
  payrollsAsFactory    Payroll[]          @relation("FactoryPayrolls")
  payrollsAsAgency     Payroll[]          @relation("AgencyPayrolls")
  purchaseOrders    PurchaseOrder[]
  vendors           Vendor[]
  journalEntries    JournalEntry[]
  ledgers           Ledger[]
  gstReturns        GSTReturn[]
  notifications     Notification[]
  // Sprint 1-5 relations
  fileAttachments   FileAttachment[]
  checkIns          CheckInOut[]       @relation("FactoryCheckIns")
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  qualityChecks     QualityCheck[]
  transporters      Transporter[]
  dispatches        Dispatch[]
  quotations        Quotation[]
  invoices          Invoice[]
  chatRooms         ChatRoom[]
  billsOfMaterial   BillOfMaterial[]
  whatsappMessages  WhatsAppMessage[]
  videoCalls        VideoCall[]
  employeeProfiles  EmployeeProfile[]
  relationshipsFrom OrgRelationship[] @relation("RelationshipFrom")
  relationshipsTo   OrgRelationship[] @relation("RelationshipTo")
  invitations       Invitation[]

  @@index([type])
  @@index([isActive])
  @@map("organisations")
}

model User {
  id        String    @id @default(uuid())
  orgId     String
  name      String
  phone     String    @unique
  email     String?   @unique
  role      UserRole
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())

  organisation   Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departments    Department[]       @relation("DepartmentManager")
  ordersCreated  Order[]            @relation("OrderCreatedBy")
  jobCardsAssigned JobCard[]        @relation("JobCardAssignee")
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  attendanceApproved AttendanceRecord[] @relation("AttendanceApprover")
  journalEntries JournalEntry[]     @relation("JournalCreator")
  gstReturnsFiled GSTReturn[]       @relation("GSTFiler")
  notifications  Notification[]
  // Sprint 1-5 relations
  filesUploaded    FileAttachment[]  @relation("FileUploader")
  stockMovements   StockMovement[]   @relation("StockMovementCreator")
  qcInspections    QualityCheck[]    @relation("QCInspector")
  quotationsCreated Quotation[]      @relation("QuotationCreator")
  invoicesCreated  Invoice[]         @relation("InvoiceCreator")
  chatMemberships  ChatMember[]
  messagesSent     ChatMessage[]     @relation("MessageSender")
  videoCallsInitiated VideoCall[]    @relation("CallInitiator")
  employeeProfile  EmployeeProfile?
  checkIns         CheckInOut[]     @relation("UserCheckIns")
  invitedRelationships OrgRelationship[] @relation("RelationshipInviter")
  invitationsSent  Invitation[]     @relation("InvitationInviter")

  @@index([orgId])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model OTP {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, code])
  @@index([expiresAt])
  @@map("otps")
}

model Department {
  id        String  @id @default(uuid())
  orgId     String
  name      String
  managerId String?
  sequence  Int     @default(0)
  isActive  Boolean @default(true)

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager      User?              @relation("DepartmentManager", fields: [managerId], references: [id])
  jobCards     JobCard[]
  employees    EmployeeProfile[]

  @@index([orgId])
  @@index([orgId, sequence])
  @@map("departments")
}

model Order {
  id           String      @id @default(uuid())
  orgId        String
  customerId   String
  orderNumber  String
  productName  String
  quantity     Float
  unit         String
  deliveryDate DateTime
  status       OrderStatus @default(ENQUIRY)
  totalValue   BigInt      // paise
  advancePaid  BigInt      @default(0) // paise
  notes        String?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  organisation Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  creator      User            @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  jobCards     JobCard[]
  qualityChecks QualityCheck[]
  dispatches   Dispatch[]
  invoices     Invoice[]
  quotation    Quotation?      @relation("QuotationOrder")

  @@unique([orgId, orderNumber])
  @@index([orgId])
  @@index([orgId, status])
  @@index([customerId])
  @@map("orders")
}

model JobCard {
  id             String        @id @default(uuid())
  orderId        String
  departmentId   String
  orgId          String
  assignedTo     String?
  status         JobCardStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  estimatedHours Float?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id])
  organisation  Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee      User?          @relation("JobCardAssignee", fields: [assignedTo], references: [id])
  qualityChecks QualityCheck[]

  @@index([orgId])
  @@index([orderId])
  @@index([departmentId, status])
  @@map("job_cards")
}

model Customer {
  id                String  @id @default(uuid())
  orgId             String
  name              String
  phone             String
  email             String?
  gstin             String?
  address           String?
  creditLimit       BigInt  @default(0) // paise
  outstandingAmount BigInt  @default(0) // paise

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orders       Order[]
  quotations   Quotation[]
  invoices     Invoice[]

  @@index([orgId])
  @@index([orgId, name])
  @@map("customers")
}

// ======================================================================
// Workers / attendance / payroll (staffing agency domain)
// ======================================================================

model Worker {
  id           String   @id @default(uuid())
  agencyOrgId  String
  name         String
  phone        String
  aadhaarLast4 String
  skill        String
  dailyRate    BigInt   // paise
  epfNumber    String?
  esicNumber   String?
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())

  agency      Organisation       @relation("AgencyWorkers", fields: [agencyOrgId], references: [id], onDelete: Cascade)
  deployments WorkerDeployment[]
  attendance  AttendanceRecord[]
  payrolls    Payroll[]
  checkIns    CheckInOut[]

  @@index([agencyOrgId])
  @@index([isActive])
  @@map("workers")
}

model WorkerDeployment {
  id           String                 @id @default(uuid())
  workerId     String
  factoryOrgId String
  agencyOrgId  String
  startDate    DateTime
  endDate      DateTime?
  status       WorkerDeploymentStatus @default(ACTIVE)

  worker  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  factory Organisation @relation("FactoryDeployments", fields: [factoryOrgId], references: [id])
  agency  Organisation @relation("AgencyDeployments", fields: [agencyOrgId], references: [id])

  @@index([workerId])
  @@index([factoryOrgId, status])
  @@index([agencyOrgId, status])
  @@map("worker_deployments")
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  workerId     String
  factoryOrgId String
  agencyOrgId  String
  date         DateTime         @db.Date
  status       AttendanceStatus
  overtime     Float            @default(0) // hours
  markedBy     String
  approvedBy   String?
  approvedAt   DateTime?
  disputeNote  String?
  isDisputed   Boolean          @default(false)

  worker   Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  factory  Organisation @relation("FactoryAttendance", fields: [factoryOrgId], references: [id])
  agency   Organisation @relation("AgencyAttendance", fields: [agencyOrgId], references: [id])
  marker   User         @relation("AttendanceMarker", fields: [markedBy], references: [id])
  approver User?        @relation("AttendanceApprover", fields: [approvedBy], references: [id])

  @@unique([workerId, date])
  @@index([factoryOrgId, date])
  @@index([agencyOrgId, date])
  @@index([isDisputed])
  @@map("attendance_records")
}

model Payroll {
  id             String        @id @default(uuid())
  workerId       String
  agencyOrgId    String
  factoryOrgId   String
  month          Int
  year           Int
  daysPresent    Int
  daysAbsent     Int
  overtimeHours  Float
  basicAmount    BigInt        // paise
  epfDeduction   BigInt        // paise
  esicDeduction  BigInt        // paise
  netAmount      BigInt        // paise
  status         PayrollStatus @default(DRAFT)
  paidAt         DateTime?

  worker  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  agency  Organisation @relation("AgencyPayrolls", fields: [agencyOrgId], references: [id])
  factory Organisation @relation("FactoryPayrolls", fields: [factoryOrgId], references: [id])

  @@unique([workerId, month, year])
  @@index([agencyOrgId, month, year])
  @@index([factoryOrgId, month, year])
  @@map("payrolls")
}

// ======================================================================
// Procurement
// ======================================================================

model PurchaseOrder {
  id           String              @id @default(uuid())
  orgId        String
  vendorId     String
  poNumber     String
  items        Json
  totalAmount  BigInt              // paise
  gstAmount    BigInt              // paise
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  receivedDate DateTime?

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id])

  @@unique([orgId, poNumber])
  @@index([orgId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model Vendor {
  id          String  @id @default(uuid())
  orgId       String
  name        String
  phone       String
  gstin       String?
  address     String?
  rating      Float?
  totalOrders Int     @default(0)

  organisation   Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([orgId])
  @@index([orgId, name])
  @@map("vendors")
}

// ======================================================================
// Finance / accounting
// ======================================================================

model JournalEntry {
  id            String            @id @default(uuid())
  orgId         String
  date          DateTime          @db.Date
  description   String
  debitLedger   String
  creditLedger  String
  amount        BigInt            // paise
  currency      String            @default("INR")
  sourceType    JournalSourceType @default(MANUAL)
  sourceId      String?
  createdAuto   Boolean           @default(false)
  createdBy     String?
  financialYear String

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User?        @relation("JournalCreator", fields: [createdBy], references: [id])

  @@index([orgId, date])
  @@index([orgId, financialYear])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model Ledger {
  id       String     @id @default(uuid())
  orgId    String
  name     String
  type     LedgerType
  parentId String?
  code     String
  isSystem Boolean    @default(false)

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       Ledger?      @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children     Ledger[]     @relation("LedgerHierarchy")

  @@unique([orgId, code])
  @@index([orgId, type])
  @@map("ledgers")
}

model GSTReturn {
  id       String          @id @default(uuid())
  orgId    String
  period   String
  type     GSTReturnType
  status   GSTReturnStatus @default(DRAFT)
  filedAt  DateTime?
  filedBy  String?
  data     Json

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  filer        User?        @relation("GSTFiler", fields: [filedBy], references: [id])

  @@unique([orgId, period, type])
  @@index([orgId, status])
  @@map("gst_returns")
}

// ======================================================================
// Notifications
// ======================================================================

model Notification {
  id       String              @id @default(uuid())
  userId   String
  orgId    String
  type     NotificationType
  title    String
  body     String
  isRead   Boolean             @default(false)
  channel  NotificationChannel @default(INAPP)
  metadata Json?
  sentAt   DateTime?
  createdAt DateTime           @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([orgId])
  @@index([createdAt])
  @@map("notifications")
}

// ======================================================================
// Factory direct employees
// ======================================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  PROBATION
  INTERN
}

model EmployeeProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  orgId           String
  departmentId    String?
  employmentType  EmploymentType @default(FULL_TIME)
  designation     String
  monthlySalary   BigInt         @default(0)  // paise
  joiningDate     DateTime       @default(now())
  exitDate        DateTime?
  bankAccount     String?
  ifscCode        String?
  panNumber       String?
  aadhaarLast4    String?
  emergencyPhone  String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id])

  @@index([orgId])
  @@index([departmentId])
  @@map("employee_profiles")
}

// ======================================================================
// Sprint 1: File storage, Check-in/out, Inventory, Quality checks
// ======================================================================

enum FileCategory {
  INVOICE
  CHALLAN
  QC_CERTIFICATE
  WORKER_DOCUMENT
  RECEIPT
  PURCHASE_ORDER
  QUOTATION
  PROFILE_PHOTO
  PROOF_OF_DELIVERY
  OTHER
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  GENERAL
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum StockReferenceType {
  PURCHASE
  PRODUCTION
  MANUAL
  RETURN
}

enum QualityCheckStatus {
  PENDING
  PASSED
  FAILED
  REWORK
}

model FileAttachment {
  id           String       @id @default(uuid())
  orgId        String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  category     FileCategory @default(OTHER)
  relatedType  String?
  relatedId    String?
  uploadedBy   String
  createdAt    DateTime     @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader     User         @relation("FileUploader", fields: [uploadedBy], references: [id])

  @@index([orgId, category])
  @@index([relatedType, relatedId])
  @@map("file_attachments")
}

model CheckInOut {
  id           String    @id @default(uuid())
  workerId     String?
  userId       String?
  factoryOrgId String
  date         DateTime  @db.Date
  checkInTime  DateTime?
  checkOutTime DateTime?
  checkInLat   Float?
  checkInLng   Float?
  checkOutLat  Float?
  checkOutLng  Float?
  shiftType    ShiftType @default(GENERAL)
  isLate       Boolean   @default(false)
  isEarlyLeave Boolean   @default(false)
  totalHours   Float?
  notes        String?

  worker  Worker?      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user    User?        @relation("UserCheckIns", fields: [userId], references: [id], onDelete: Cascade)
  factory Organisation @relation("FactoryCheckIns", fields: [factoryOrgId], references: [id])

  @@index([factoryOrgId, date])
  @@index([workerId, date])
  @@index([userId, date])
  @@map("check_in_outs")
}

model InventoryItem {
  id           String  @id @default(uuid())
  orgId        String
  name         String
  sku          String?
  unit         String
  currentStock Float   @default(0)
  minimumStock Float   @default(0)
  location     String?
  category     String?
  costPerUnit  BigInt  @default(0) // paise

  organisation Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  bomItems     BOMItem[]

  @@unique([orgId, sku])
  @@index([orgId])
  @@index([orgId, category])
  @@map("inventory_items")
}

model StockMovement {
  id              String             @id @default(uuid())
  inventoryItemId String
  orgId           String
  type            StockMovementType
  quantity        Float
  referenceType   StockReferenceType @default(MANUAL)
  referenceId     String?
  notes           String?
  createdBy       String
  createdAt       DateTime           @default(now())

  item         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User          @relation("StockMovementCreator", fields: [createdBy], references: [id])

  @@index([inventoryItemId])
  @@index([orgId, createdAt])
  @@map("stock_movements")
}

model QualityCheck {
  id             String             @id @default(uuid())
  orgId          String
  orderId        String?
  jobCardId      String?
  checklistItems Json
  status         QualityCheckStatus @default(PENDING)
  defectNotes    String?
  inspectedBy    String?
  inspectedAt    DateTime?
  createdAt      DateTime           @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id])
  jobCard      JobCard?     @relation(fields: [jobCardId], references: [id])
  inspector    User?        @relation("QCInspector", fields: [inspectedBy], references: [id])

  @@index([orgId, status])
  @@index([orderId])
  @@map("quality_checks")
}

// ======================================================================
// Sprint 2: Transport, Invoices, Quotations
// ======================================================================

enum DispatchStatus {
  PREPARING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  CANCELLED
  OVERDUE
}

model Transporter {
  id            String  @id @default(uuid())
  orgId         String
  name          String
  phone         String
  vehicleNumber String?
  vehicleType   String?
  isActive      Boolean @default(true)

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dispatches   Dispatch[]

  @@index([orgId])
  @@map("transporters")
}

model Dispatch {
  id                   String         @id @default(uuid())
  orgId                String
  orderId              String
  transporterId        String?
  vehicleNumber        String?
  driverName           String?
  driverPhone          String?
  ewayBillNumber       String?
  dispatchDate         DateTime
  expectedDeliveryDate DateTime?
  deliveredAt          DateTime?
  proofOfDeliveryUrl   String?
  freightCost          BigInt         @default(0) // paise
  status               DispatchStatus @default(PREPARING)
  notes                String?

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id])
  transporter  Transporter? @relation(fields: [transporterId], references: [id])

  @@index([orgId, status])
  @@index([orderId])
  @@map("dispatches")
}

model Quotation {
  id               String          @id @default(uuid())
  orgId            String
  customerId       String
  quotationNumber  String
  items            Json
  subtotal         BigInt          // paise
  gstAmount        BigInt          // paise
  totalAmount      BigInt          // paise
  validUntil       DateTime
  status           QuotationStatus @default(DRAFT)
  convertedOrderId String?         @unique
  notes            String?
  createdBy        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organisation  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id])
  creator       User         @relation("QuotationCreator", fields: [createdBy], references: [id])
  convertedOrder Order?      @relation("QuotationOrder", fields: [convertedOrderId], references: [id])

  @@unique([orgId, quotationNumber])
  @@index([orgId, status])
  @@index([customerId])
  @@map("quotations")
}

model Invoice {
  id            String        @id @default(uuid())
  orgId         String
  orderId       String?
  customerId    String
  invoiceNumber String
  invoiceDate   DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  items         Json
  subtotal      BigInt        // paise
  gstAmount     BigInt        // paise
  totalAmount   BigInt        // paise
  paidAmount    BigInt        @default(0) // paise
  status        InvoiceStatus @default(DRAFT)
  pdfUrl        String?
  einvoiceJson  Json?
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  creator      User         @relation("InvoiceCreator", fields: [createdBy], references: [id])

  @@unique([orgId, invoiceNumber])
  @@index([orgId, status])
  @@index([customerId])
  @@map("invoices")
}

// ======================================================================
// Sprint 3: Chat, BOM
// ======================================================================

enum ChatRoomType {
  GROUP
  DIRECT
  ORDER_DISCUSSION
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

model ChatRoom {
  id          String       @id @default(uuid())
  orgId       String
  name        String?
  type        ChatRoomType @default(GROUP)
  relatedType String?
  relatedId   String?
  createdAt   DateTime     @default(now())

  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      ChatMember[]
  messages     ChatMessage[]

  @@index([orgId])
  @@index([relatedType, relatedId])
  @@map("chat_rooms")
}

model ChatMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  mutedAt  DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id          String      @id @default(uuid())
  roomId      String
  senderId    String
  content     String
  messageType MessageType @default(TEXT)
  fileUrl     String?
  replyToId   String?
  readBy      Json        @default("[]")
  createdAt   DateTime    @default(now())
  editedAt    DateTime?

  room    ChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender  User         @relation("MessageSender", fields: [senderId], references: [id])
  replyTo ChatMessage? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies ChatMessage[] @relation("MessageReplies")

  @@index([roomId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model BillOfMaterial {
  id          String   @id @default(uuid())
  orgId       String
  productName String
  productCode String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        BOMItem[]

  @@unique([orgId, productCode])
  @@index([orgId])
  @@map("bills_of_material")
}

model BOMItem {
  id              String @id @default(uuid())
  bomId           String
  inventoryItemId String
  quantity        Float
  unit            String
  wastagePercent  Float  @default(0)

  bom           BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@index([bomId])
  @@map("bom_items")
}

// ======================================================================
// Sprint 4: WhatsApp message log
// ======================================================================

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppMessage {
  id          String                 @id @default(uuid())
  orgId       String
  phone       String
  templateName String?
  content     String
  direction   String                 @default("OUTBOUND") // OUTBOUND or INBOUND
  status      WhatsAppMessageStatus  @default(QUEUED)
  waMessageId String?
  metadata    Json?
  sentAt      DateTime?
  createdAt   DateTime               @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([phone])
  @@map("whatsapp_messages")
}

// ======================================================================
// Sprint 5: Video calls
// ======================================================================

enum VideoCallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
}

model VideoCall {
  id           String          @id @default(uuid())
  orgId        String
  roomToken    String          @unique
  initiatedBy  String
  callType     String          @default("VIDEO") // VIDEO or AUDIO
  status       VideoCallStatus @default(RINGING)
  participants Json            @default("[]")
  relatedType  String?
  relatedId    String?
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  durationSecs Int?

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  initiator    User         @relation("CallInitiator", fields: [initiatedBy], references: [id])

  @@index([orgId, startedAt])
  @@map("video_calls")
}

// ======================================================================
// Organisation relationships and invitations
// ======================================================================

enum OrgRelationshipType {
  FACTORY_AGENCY    // Factory <-> Staffing Agency
  FACTORY_CA        // Factory <-> CA Firm
  FACTORY_CUSTOMER  // Factory <-> Customer (if the customer ever onboards)
}

enum OrgRelationshipStatus {
  PENDING   // Invitation sent, awaiting acceptance
  ACTIVE    // Both parties agreed
  REJECTED
  ENDED     // Previously active, now terminated
}

model OrgRelationship {
  id         String                @id @default(uuid())
  fromOrgId  String
  toOrgId    String
  type       OrgRelationshipType
  status     OrgRelationshipStatus @default(PENDING)
  invitedBy  String
  acceptedAt DateTime?
  endedAt    DateTime?
  notes      String?
  createdAt  DateTime              @default(now())

  fromOrg Organisation @relation("RelationshipFrom", fields: [fromOrgId], references: [id], onDelete: Cascade)
  toOrg   Organisation @relation("RelationshipTo", fields: [toOrgId], references: [id], onDelete: Cascade)
  inviter User         @relation("RelationshipInviter", fields: [invitedBy], references: [id])

  @@unique([fromOrgId, toOrgId, type])
  @@index([fromOrgId, status])
  @@index([toOrgId, status])
  @@map("org_relationships")
}

enum InvitationType {
  TEAM_MEMBER      // Invite a colleague to join your org
  ORG_RELATIONSHIP // Invite another business (CA, agency) to connect
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id           String           @id @default(uuid())
  orgId        String
  invitedBy    String
  type         InvitationType
  status       InvitationStatus @default(PENDING)
  token        String           @unique @default(uuid())

  // For TEAM_MEMBER:
  inviteePhone String?
  inviteeName  String?
  inviteeRole  UserRole?

  // For ORG_RELATIONSHIP:
  targetOrgType  OrganisationType?
  targetOrgName  String?
  targetGstin    String?
  targetPhone    String?
  relationshipType OrgRelationshipType?

  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedBy   String?
  createdAt    DateTime         @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [invitedBy], references: [id])

  @@index([orgId, status])
  @@index([inviteePhone])
  @@index([token])
  @@map("invitations")
}
