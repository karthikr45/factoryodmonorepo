# ==============================================================================
# FactoryOS Environment Variables - Example
# Copy to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# ---- Node ----
NODE_ENV=development

# ---- Database (Supabase Postgres) ----
# Pooled connection for apps
DATABASE_URL=postgresql://karthik:Maruthi@2013@localhost:5432/nutrition_db?schema=public
# Direct connection for migrations
DIRECT_URL=postgresql://karthik:Maruthi@2013@localhost:5432/nutrition_db?schema=public

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth / JWT ----
JWT_SECRET=replace-with-strong-random-string
JWT_REFRESH_SECRET=replace-with-different-strong-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- NextAuth (apps/web) ----
NEXTAUTH_SECRET=replace-with-strong-random-string
NEXTAUTH_URL=http://localhost:3000

# ---- API URL (consumed by web and mobile) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---- Redis (Upstash) ----
REDIS_URL=redis://default:password@your-redis.upstash.io:6379

# ---- Twilio (OTP via SMS) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1XXXXXXXXXX

# ---- WhatsApp Business API ----
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-number-id

# ---- Anthropic Claude API (apps/ai) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-6

# ---- AI Service URL ----
AI_SERVICE_URL=http://localhost:8000

# ---- Sentry ----
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ---- CORS / Frontend origins ----
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ---- Feature flags ----
ENABLE_WHATSAPP=false
ENABLE_AI_INSIGHTS=false
